{
  "name": "ssh-mcp-server",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist",
    "build/Release/windows_trust.node",
    "build/Release/ssh-mcp-approver.exe",
    "build/Release/posix_peer_credentials.node",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "skills",
    "scripts"
  ],
  "description": "Secure MCP server for approved SSH profile discovery, validation, and bounded remote command execution without agent-supplied credentials.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:native": "node-gyp rebuild",
    "install": "node -e \"process.exit(0)\"",
    "check": "tsc --project tsconfig.test.json --noEmit",
    "lint": "npm run check && eslint src test",
    "lint:fix": "prettier --write --ignore-path .gitignore . && eslint src test --fix",
    "format": "prettier --write --ignore-path .gitignore .",
    "format:check": "prettier --check --ignore-path .gitignore .",
    "start": "node dist/server.js",
    "windows:audit:init": "node scripts/windows-audit-journal.mjs init",
    "windows:audit:rotate": "node scripts/windows-audit-journal.mjs rotate",
    "windows:approver": "node scripts/windows-approver.mjs",
    "test": "tsx --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node -e \"if (process.env.SSH_INTEGRATION_TEST !== 'true') throw new Error('Set SSH_INTEGRATION_TEST=true to run integration tests.');\" && tsx --test \"test/integration/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "@types/ssh2": "1.15.6",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "node-gyp": "^12.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ssh2": "1.17.0"
  }
}
